{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Platform": {
    "CorrelationHeaderName": "X-Correlation-ID",
    "RateLimit": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "LocalStorage": {
      "RootPath": "App_Data/storage",
      "ExportRetentionHours": 24,
      "ExportCleanupMinutes": 60
    }
  },
  "SensitiveConfiguration": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
